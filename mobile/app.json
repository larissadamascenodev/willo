{
  "expo": {
    "name": "Willo",
    "slug": "willo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "willo",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090A",
    "ios": {
      "bundleIdentifier": "com.willo.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.willo.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Willo usa a câmera para ler suas faturas e comprovantes."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "O Willo usa o microfone para você registrar gastos falando."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Willo usa suas fotos para ler comprovantes e para a capa dos seus cofrinhos, só as que você escolher."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2d556821-d8c3-4e2c-af43-e12ad03e0594"
      }
    },
    "owner": "larissaddamasceno.dev",
    "updates": {
      "url": "https://u.expo.dev/2d556821-d8c3-4e2c-af43-e12ad03e0594"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
